# Copia este fichero a .env y rellena lo que uses. .env NO se sube a git.

# --- Cerebros (necesitas al menos uno) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cual usa por defecto: claude | gpt
JANUS_BRAIN=claude

# Modelos. Cambialos si quieres otro.
JANUS_CLAUDE_MODEL=claude-opus-5-5
JANUS_GPT_MODEL=gpt-5.1

# --- Voz ---
# browser = reconocimiento y voz del navegador (gratis, sin instalar nada)
# openai  = Whisper para transcribir y TTS para hablar (requiere OPENAI_API_KEY)
JANUS_VOICE=browser

# --- Servidor ---
JANUS_HOST=127.0.0.1
JANUS_PORT=8700
JANUS_TZ=Europe/Madrid

# --- Modo programador ---
# Ruta al ejecutable de Claude Code. Si lo instalas con
# npm install -g @anthropic-ai/claude-code, dejalo vacio: se detecta solo.
JANUS_CLAUDE_CLI=
